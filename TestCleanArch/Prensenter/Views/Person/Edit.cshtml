@model Domain.Dtos.PersonaDepartamentoListDto

@{
    ViewData["Title"] = "Edit";
}

<h1>Editar Persona</h1>

<h4>PersonaDepartamentoListDto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Persona.ID" />

            <div class="form-group">
                <label asp-for="Persona.name" class="control-label"></label>
                <input asp-for="Persona.name" class="form-control" />
                <span asp-validation-for="Persona.name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.surname" class="control-label"></label>
                <input asp-for="Persona.surname" class="form-control" />
                <span asp-validation-for="Persona.surname" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.age" class="control-label"></label>
                <input asp-for="Persona.age" class="form-control" />
                <span asp-validation-for="Persona.age" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.direccion" class="control-label"></label>
                <input asp-for="Persona.direccion" class="form-control" />
                <span asp-validation-for="Persona.direccion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.fechaNac" class="control-label"></label>
                <input asp-for="Persona.fechaNac" class="form-control" type="date" /> <span asp-validation-for="Persona.fechaNac" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.telefono" class="control-label"></label>
                <input asp-for="Persona.telefono" class="form-control" />
                <span asp-validation-for="Persona.telefono" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona.foto" class="control-label"></label>
                <input asp-for="Persona.foto" class="form-control" />
                <span asp-validation-for="Persona.foto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Persona._departamento" class="control-label">Departamento</label>
                
                <span asp-validation-for="Persona._departamento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}